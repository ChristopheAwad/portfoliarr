<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- USE_BIOMETRIC covers API 28+; API 24-27 only knows
         USE_FINGERPRINT, and minSdk is 24, so both are declared. Neither
         grants anything on its own — the prompt still only appears once a
         login has been saved and the user has not switched the feature
         off. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <!-- #58 in-app update: installing an APK needs this on API 26+. It is a
         normal permission on API 24-25 and changes nothing until the update
         flow runs; the per-app grant is requested at install time. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Portfoliarr"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".SettingsActivity" />

        <!-- #51 home-screen widget. exported="false": the system still
             delivers APPWIDGET_UPDATE to the provider (the documented
             pattern), and no other app can poke it. The custom REFRESH
             action is what the widget's refresh tap broadcasts. -->
        <receiver
            android:name=".widget.PortfolioWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.portfoliarr.app.widget.action.REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- #51 widget connect screen. The launcher starts it when a widget
             is added (android:configure in widget_info.xml), so it must be
             exported; it only displays data and stores the resulting token
             in this app's private preferences. It never returns a token to
             the caller and never logs the session. -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_config_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- #59 watchlist widget. Same private-provider pattern as #51; its
             ListView rows are bound through the RemoteViewsService below. -->
        <receiver
            android:name=".widget.WatchlistWidgetProvider"
            android:exported="false"
            android:label="@string/widget_watchlist_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.portfoliarr.app.widget.action.WATCHLIST_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_watchlist_info" />
        </receiver>

        <!-- The watchlist widget's collection service. The system binds to
             it; nothing else may. -->
        <service
            android:name=".widget.WatchlistWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- #59 watchlist widget connect screen (exported for the launcher). -->
        <activity
            android:name=".widget.WatchlistWidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_watchlist_config_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- #58 in-app update: hands the verified APK to the system
             installer. Exposes exactly one directory (res/xml/file_paths.xml)
             and nothing else; unexported, grant-only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.portfoliarr.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
