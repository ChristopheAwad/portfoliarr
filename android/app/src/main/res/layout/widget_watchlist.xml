<?xml version="1.0" encoding="utf-8"?>
<!-- The watchlist widget (#59): a header (title, fetch time, refresh) over a
     scrollable ListView of watched tickers. RemoteViews supports a limited
     view set, so the rows are a RemoteViews collection built by
     WatchlistWidgetFactory. The renderer shows widget_watchlist_empty and
     hides the list when there is nothing to show. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_watchlist_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_watchlist_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/widget_watchlist_title"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_watchlist_asof"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/widget_text_muted"
            android:textSize="9sp" />

        <ImageView
            android:id="@+id/widget_watchlist_refresh"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/widget_refresh"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_popup_sync" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_watchlist_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:paddingTop="6dp"
        android:singleLine="true"
        android:textColor="@color/widget_text_muted"
        android:textSize="11sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/widget_watchlist_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="4dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />
</LinearLayout>
