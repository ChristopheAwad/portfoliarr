<?xml version="1.0" encoding="utf-8"?>
<!-- The widget connect screen (#51): status line, portfolio picker,
     Connect, and two fallback buttons. Shown by the launcher when a widget
     is added. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/config_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp" />

    <Spinner
        android:id="@+id/config_portfolio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/config_connect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/widget_config_connect"
        android:visibility="gone" />

    <Button
        android:id="@+id/config_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/widget_config_retry"
        android:visibility="gone" />

    <Button
        android:id="@+id/config_open_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/widget_config_open_app"
        android:visibility="gone" />
</LinearLayout>
