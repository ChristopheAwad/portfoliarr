<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded card behind every widget state. The color flips with the system
     dark mode through values-night/colors.xml. A plain shape is all
     RemoteViews can inflate as a background. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="@color/widget_bg" />
</shape>
