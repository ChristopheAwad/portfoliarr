    <string name="update_download_failed">Download failed</string>
    <string name="update_download_cancelled">Download cancelled</string>
    <string name="update_hash_mismatch">Update file failed verification and was deleted</string>
    <string name="update_install_ready_title">Update downloaded</string>
    <string name="update_install_ready_message">Install version %1$s now?</string>
    <string name="update_install">Install</string>
    <string name="update_unknown_sources_title">Permission needed</string>
